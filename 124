class TreeNode(object):
    def __init__(self, x):
        self.val = x
        self.left = None
        self.right = None

class Solution:
    def maxPathSum(self, root):
        """Returns the maximum path sum."""
        self.max_sum = float('-inf')  # Inicializa a soma máxima com o menor valor possível.

        def dfs(node):
            if not node:
                return 0  # Se o nó for nulo, retorna 0

            # Calcula o valor máximo entre o caminho esquerdo e o direito, mas não permite valores negativos.
            left = max(dfs(node.left), 0)
            right = max(dfs(node.right), 0)

            # Atualiza a soma máxima com o maior valor possível de caminho passando pela raiz atual.
            self.max_sum = max(self.max_sum, node.val + left + right)

            # Retorna o valor máximo entre a raiz atual e os caminhos para os filhos.
            return node.val + max(left, right)

        dfs(root)  # Inicia a DFS
        return self.max_sum
